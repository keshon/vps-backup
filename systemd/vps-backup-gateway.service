[Unit]
Description=Append-only restic gateway to rclone cloud storage
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vps-backup --config /etc/vps-backup/server.json gateway
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/vps-backup

[Install]
WantedBy=multi-user.target
